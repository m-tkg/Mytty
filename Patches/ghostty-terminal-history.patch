+    /// Returns the cursor's grid position in active-area coordinates
+    /// (zero-based column and row). Unlike ghostty_surface_ime_point,
+    /// this is exact grid state, not a pixel position derived from cell
+    /// metrics and padding.
+    export fn ghostty_surface_cursor_position(
+        surface: *Surface,
+        x: *u32,
+        y: *u32,
+    ) void {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lock();
+        defer core_surface.renderer_state.mutex.unlock();
+        const cursor = core_surface.renderer_state.terminal.screens.active.cursor;
+        x.* = @intCast(cursor.x);
+        y.* = @intCast(cursor.y);
+    }
+
+    /// Creates a tracked pin at the given unscaled surface coordinates
+    /// (the same coordinate space the host feeds to
+    /// ghostty_surface_mouse_pos; scaling to pixels happens here, like
+    /// cursorPosCallback), for use as a "line bookmark" an embedder can
+    /// later scroll back to. Only the primary screen has meaningful
+    /// scrollback to bookmark, so this returns null while the alternate
+    /// screen is active or the point otherwise can't be pinned. The
+    /// returned pin is tracked: it follows content as the pagelist is
+    /// modified, and is relocated to the top-left of the screen if the
+    /// line it points to is fully evicted (see PageList.trackPin). The
+    /// caller owns the pin and must release it with
+    /// ghostty_surface_bookmark_free.
+    export fn ghostty_surface_bookmark_create(
+        surface: *Surface,
+        x: f64,
+        y: f64,
+    ) ?*anyopaque {
+        const pos = surface.cursorPosToPixels(.{
+            .x = @floatCast(x),
+            .y = @floatCast(y),
+        }) catch |err| {
+            log.warn("error scaling bookmark position err={}", .{err});
+            return null;
+        };
+
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lock();
+        defer core_surface.renderer_state.mutex.unlock();
+
+        const t = core_surface.renderer_state.terminal;
+        if (t.screens.active_key != .primary) return null;
+        const screen = t.screens.active;
+
+        const coord = core_surface.posToViewport(pos.x, pos.y);
+        const p = screen.pages.pin(.{ .viewport = coord }) orelse return null;
+        return screen.pages.trackPin(p) catch |err| {
+            log.warn("error tracking bookmark pin err={}", .{err});
+            return null;
+        };
+    }
+
+    /// Resolves a bookmark pin's current row/column in the primary
+    /// screen along with whether the primary screen is currently active.
+    /// The pin always belongs to the primary screen's pagelist (bookmarks
+    /// can only be created while it's active), so this resolves against
+    /// that pagelist regardless of which screen is active right now.
+    /// Returns false only if the point genuinely can't be resolved; a
+    /// fully evicted line still resolves (relocated to the top-left, per
+    /// ghostty_surface_bookmark_create's docs), so callers detect
+    /// eviction by checking the resolved row/x, not this return value.
+    export fn ghostty_surface_bookmark_info(
+        surface: *Surface,
+        pin_ptr: *anyopaque,
+        out: *BookmarkInfo,
+    ) bool {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lock();
+        defer core_surface.renderer_state.mutex.unlock();
+
+        const t = core_surface.renderer_state.terminal;
+        const primary = t.screens.get(.primary).?;
+        const pin: *terminal.Pin = @ptrCast(@alignCast(pin_ptr));
+        const pt = primary.pages.pointFromPin(.screen, pin.*) orelse
+            return false;
+        const coord = pt.coord();
+
+        out.* = .{
+            .row = coord.y,
+            .x = @intCast(coord.x),
+            .screen_is_active = t.screens.active_key == .primary,
+        };
+        return true;
+    }
+
+    /// Scrolls the viewport to the given bookmark pin. No-op while the
+    /// alternate screen is active, since there is no scrollback to
+    /// scroll to and the pin belongs to the primary screen's pagelist.
+    export fn ghostty_surface_bookmark_scroll(
+        surface: *Surface,
+        pin_ptr: *anyopaque,
+    ) void {
+        {
+            const core_surface = &surface.core_surface;
+            core_surface.renderer_state.mutex.lock();
+            defer core_surface.renderer_state.mutex.unlock();
+
+            const t = core_surface.renderer_state.terminal;
+            if (t.screens.active_key != .primary) return;
+
+            const pin: *terminal.Pin = @ptrCast(@alignCast(pin_ptr));
+            t.screens.active.scroll(.{ .pin = pin.* });
+        }
+
+        surface.refresh();
+    }
+
+    /// Reads the full text of the row a bookmark pin currently points
+    /// to, resolved through the pin itself rather than point
+    /// coordinates — the generic ghostty_surface_read_text clamps exact
+    /// y coordinates to the viewport height, so it cannot address
+    /// scrollback rows. The result must be freed with
+    /// ghostty_surface_free_text.
+    export fn ghostty_surface_bookmark_text(
+        surface: *Surface,
+        pin_ptr: *anyopaque,
+        result: *Text,
+    ) bool {
+        surface.core_surface.renderer_state.mutex.lock();
+        defer surface.core_surface.renderer_state.mutex.unlock();
+
+        const pin: *terminal.Pin = @ptrCast(@alignCast(pin_ptr));
+        var start = pin.*;
+        start.x = 0;
+        var end = pin.*;
+        end.x = end.node.cols() - 1;
+
+        const core_sel: terminal.Selection = .{
+            .bounds = .{ .untracked = .{ .start = start, .end = end } },
+            .rectangle = false,
+        };
+        return readTextLocked(surface, core_sel, result);
+    }
+
+    /// Releases a bookmark pin created by ghostty_surface_bookmark_create.
+    export fn ghostty_surface_bookmark_free(
+        surface: *Surface,
+        pin_ptr: *anyopaque,
+    ) void {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lock();
+        defer core_surface.renderer_state.mutex.unlock();
+
+        const primary = core_surface.renderer_state.terminal.screens.get(.primary).?;
+        const pin: *terminal.Pin = @ptrCast(@alignCast(pin_ptr));
+        primary.pages.untrackPin(pin);
+    }
